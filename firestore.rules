rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Verification codes and rate-limit documents are only accessed by the Admin SDK
    // inside Cloud Functions. Browser clients must never read or write them directly.
    match /signupCodes/{document=**} { allow read, write: if false; }
    match /authRateLimits/{document=**} { allow read, write: if false; }
    // Default deny: add narrowly-scoped rules later for any user-facing data collections.
    match /{document=**} { allow read, write: if false; }
  }
}
